# Copy to .env and fill in. scripts/docker_run.sh passes this file to the
# container with --env-file. Never commit the real .env (it is gitignored).

# --- Required for the LLM pipeline ---
OPENAI_API_KEY=
# Groq hosts the "gpt-oss-120b" generator/validator model.
GROQ_API_KEY=

# --- Optional ---
# Only needed if a Cohere reranker is selected (default reranker is local FlashRank).
COHERE_API_KEY=

# --- Retrieval / embedding tuning (sensible defaults if unset) ---
# "local" uses FastEmbed (free, offline); "openai" uses text-embedding-3-small.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K_RESULTS=5
# Override where the local ChromaDB lives (defaults to repo-root databases/).
# VECTOR_DB_DATABASES_DIR=/app/databases
