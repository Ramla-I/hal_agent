# Evaluation
evaluation/

# Test outputs (organized)
optimization/test_outputs/

# Devices: large binaries live in the release assets (see docs/device_assets.md),
# not in git — PDFs, SVDs (.svd/.xml), device-mapping xml, and vendor SDK zips.
devices/**/*.pdf
devices/**/*.svd
devices/**/*.xml
devices/**/*.zip

# Coverage improver optimization
coverage_improver_optimization/

# Experiment run outputs / LLM output — kept locally, never committed.
# Scripts, configs, READMEs and curated test-set CSVs in these trees stay tracked.
optimization_coverage_improver/*/
# Raw per-run outputs live under optimization_validator/experiments/<run>/ — too large
# for git (~240 MB), shipped as a zipped release asset. Keep the index README tracked.
optimization_validator/experiments/*
!optimization_validator/experiments/README.md
optimization_validator/validator_experiments.zip
optimization_validator/**/hold_set_results/
optimization_validator/**/cross_validation/
analysis/*.csv
plots/*.pdf
plots/*.png
# generated by verified_datasheet/expand_derived.py (derive a complete CSV on demand)
verified_datasheet/**/*_expanded.csv
# pac_codegen: crates.io-provisioned generated PAC for compile tests (see get_pac.py)
applications/pac_codegen/vendored/pac/
applications/pac_codegen/eval_hal/target/
# tune_constraint_validator: quote-anchoring / calibration run artifacts
tune_constraint_validator/out/
applications/pac_codegen/experiments/out/
# local-only working docs (paper draft + analysis/results reports; not for the shared repo)
temp_docs/
