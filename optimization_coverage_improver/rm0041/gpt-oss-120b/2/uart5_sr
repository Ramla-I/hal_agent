      "bit_number": {
        "start_bit": 5,
        "end_bit": 5
      },
      "enumerated_values": [
        {
          "value": "0",
          "name": "NoData"
        },
        {
          "value": "1",
          "name": "DataReady"
        }
      ]
    },
    {
