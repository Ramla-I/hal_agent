      "bit_number": {
        "start_bit": 4,
        "end_bit": 4
      },
      "enumerated_values": [
        {
          "value": "0",
          "name": "NoIdle"
        },
        {
          "value": "1",
          "name": "IdleDetected"
        }
      ]
    },
    {
