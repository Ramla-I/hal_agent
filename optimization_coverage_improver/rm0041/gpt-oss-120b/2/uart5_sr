      "access": "read-only",
      "bit_number": {
        "start_bit": 8,
        "end_bit": 8
      },
      "enumerated_values": [
        {
          "value": "0",
          "name": "BreakNotDetected"
        },
        {
          "value": "1",
          "name": "BreakDetected"
        }
      ]
    },
    {
