      "access": "read-only",
      "bit_number": {
        "start_bit": 3,
        "end_bit": 3
      },
      "enumerated_values": [
        {
          "value": "0",
          "name": "NoOverrun"
        },
        {
          "value": "1",
          "name": "OverrunDetected"
