diff -ruN --strip-trailing-cr '--exclude=target' a/src/i2c.rs b/src/i2c.rs
--- a/src/i2c.rs	2006-07-24 01:21:28.000000000 +0000
+++ b/src/i2c.rs	2026-09-17 18:59:41.377407895 +0000
@@ -781,3 +781,45 @@
 //         I2c::write_read(self, addr, bytes, buffer)
 //     }
 // }
+
+
+/// GRAFT for the elodin port experiment. stm32-hal2 2.1.10 ships this impl
+/// ONLY in the F4 dialect module (i2c_f4.rs); on the v2-I2C parts it exists
+/// as a commented-out embedded-hal-0.2 remnant, so an H7 user has no
+/// embedded-hal I2C at all -- which is why elodin pins a 1.8 fork. This
+/// delegates to the inherent write/read, taking the same
+/// per-operation-stop shortcut the F4 impl documents for itself.
+#[cfg(feature = "embedded_hal")]
+mod embedded_hal_impl {
+    use core::ops::Deref;
+
+    use embedded_hal::i2c::{ErrorType, I2c as I2cEh, Operation, SevenBitAddress};
+
+    use super::*;
+
+    impl<R> ErrorType for I2c<R>
+    where
+        R: Deref<Target = pac::i2c1::RegisterBlock> + RccPeriph,
+    {
+        type Error = crate::error::Error;
+    }
+
+    impl<R> I2cEh<SevenBitAddress> for I2c<R>
+    where
+        R: Deref<Target = pac::i2c1::RegisterBlock> + RccPeriph,
+    {
+        fn transaction(
+            &mut self,
+            address: SevenBitAddress,
+            operations: &mut [Operation<'_>],
+        ) -> core::result::Result<(), Self::Error> {
+            for op in operations {
+                match op {
+                    Operation::Write(buffer) => self.write(address, buffer)?,
+                    Operation::Read(buffer) => self.read(address, buffer)?,
+                }
+            }
+            Ok(())
+        }
+    }
+}
