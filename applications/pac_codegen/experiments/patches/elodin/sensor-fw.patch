+impl From<hal::error::Error> for Error {
+    fn from(err: hal::error::Error) -> Self {
+        match err {
+            hal::error::Error::I2cError(e) => e.into(),
+            // 2.x wraps every peripheral error in one enum; anything that is
+            // not I2C on this driver's path is a bug worth hearing about.
+            _ => Error::ConfigError,
+        }
+    }
